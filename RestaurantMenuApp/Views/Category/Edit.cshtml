@model Category
@{ ViewData["Title"] = Model.CategoryId == 0 ? "Add Category" : "Edit Category"; }
<div class="container section-pad narrow-copy"><h1 class="section-title">@ViewData["Title"]</h1><form method="post">
<input asp-for="CategoryId" type="hidden"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="CategoryName" class="form-label"></label><input asp-for="CategoryName" class="form-control"><span asp-validation-for="CategoryName" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
<div class="mb-3"><label asp-for="DisplayOrder" class="form-label"></label><input asp-for="DisplayOrder" class="form-control"></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input"><label asp-for="IsActive" class="form-check-label">Active</label></div>
<button class="btn btn-gold">Save category</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div>
