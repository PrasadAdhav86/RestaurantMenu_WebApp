<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Saffron & Stone</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
<nav class="navbar navbar-expand-lg navbar-dark site-nav">
  <div class="container">
    <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">SAFFRON <span>&</span> STONE</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Menu" asp-action="Index">Our Menu</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">Our Story</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
        @if (User.IsInRole("Admin")) {
          <li class="nav-item"><a class="btn btn-gold btn-sm" asp-controller="Admin" asp-action="Index">Dashboard</a></li>
          <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-link btn btn-link">Logout</button></form></li>
        } else {
          <li class="nav-item"><a class="nav-link small" asp-controller="Account" asp-action="Login">Admin</a></li>
        }
      </ul>
    </div>
  </div>
</nav>
</header>
<main>
@if (TempData["Error"] is string error) { <div class="container mt-3"><div class="alert alert-warning">@error</div></div> }
@RenderBody()
</main>
<footer class="footer mt-5">
  <div class="container py-5">
    <div class="row g-4">
      <div class="col-md-5"><div class="brand text-white mb-2">SAFFRON <span>&</span> STONE</div><p class="text-light-muted">Thoughtful ingredients. Honest cooking. Memorable meals.</p></div>
      <div class="col-md-3"><h6>Explore</h6><a asp-controller="Menu" asp-action="Index">Menu</a><a asp-controller="Home" asp-action="About">Our Story</a></div>
      <div class="col-md-4"><h6>Visit Us</h6><p class="text-light-muted mb-1">12 Garden Lane, Pune, Maharashtra</p><p class="text-light-muted">Open daily · 11:00 AM – 11:00 PM</p></div>
    </div>
    <hr class="border-secondary"><small class="text-light-muted">© @DateTime.Now.Year Saffron & Stone. All rights reserved.</small>
  </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
