@model IReadOnlyList<MenuItem>
@{ ViewData["Title"] = "Manage Food Items"; }
<div class="container section-pad"><div class="d-flex justify-content-between align-items-center mb-4"><h1 class="section-title mb-0">Food items</h1><a asp-action="Create" class="btn btn-gold">Add food item</a></div>
<div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>Item</th><th>Category</th><th>Price</th><th>Type</th><th>Availability</th><th class="text-end">Actions</th></tr></thead><tbody>
@foreach(var m in Model){<tr><td><strong>@m.ItemName</strong></td><td>@m.Category?.CategoryName</td><td>₹@m.Price.ToString("0.00")</td><td>@m.FoodType</td><td>@(m.IsAvailable ? "Available" : "Unavailable")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@m.MenuItemId" class="btn btn-sm btn-outline-dark">Edit</a> <form asp-action="ToggleAvailability" asp-route-id="@m.MenuItemId" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">Toggle</button></form> <form asp-action="Delete" asp-route-id="@m.MenuItemId" method="post" class="d-inline" onsubmit="return confirm('Delete this food item?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}
</tbody></table></div></div>
